# Deployment
PRIVATE_KEY=your_wallet_private_key_here

# Base URL for metadata and images (update when deploying)
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Optional: WalletConnect Project ID for better wallet integration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Plasmascan API Key for contract verification
PLASMASCAN_API_KEY=your_plasmascan_api_key_here