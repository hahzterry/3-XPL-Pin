# Deployment
PRIVATE_KEY=your_wallet_private_key_here

# Base URL for metadata and images
NEXT_PUBLIC_BASE_URL=https://gen-plasma.com

# Optional: WalletConnect Project ID for better wallet integration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Treasury address for payments
TREASURY_ADDRESS=your_treasury_address_here
NEXT_PUBLIC_TREASURY_ADDRESS=your_treasury_address_here

# Supabase Configuration (Self-Hosted)
# Set these in your deployment environment (Coolify/Vercel/etc), not here
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
